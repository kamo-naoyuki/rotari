# dunst 1.5 settings for the results episode: a dark card at the top right of
# the 1200x1620 Xvfb screen (the Web UI is drawn at scale 2 there).
[global]
    geometry = "820x0-36+40"
    font = DejaVu Sans 23
    markup = full
    format = "<b>%s</b>\n%b"
    show_indicators = no
    icon_position = off
    frame_width = 3
    frame_color = "#3a4659"
    padding = 26
    horizontal_padding = 32
    line_height = 6
    word_wrap = yes
[urgency_low]
    background = "#1b2433"
    foreground = "#e8edf3"
    timeout = 20
[urgency_normal]
    background = "#1b2433"
    foreground = "#e8edf3"
    timeout = 20
